let count = 0;

function cardCounter(card) {
  if (typeof card === 'number' && card >= 2 && card <= 6) {
    count++;
  } else if (card === 10 || card === 'J' || card === 'Q' || card === 'K' || card === 'A') {
    count--;
  }
  const decision = count > 0 ? 'Bet' : 'Hold';
  return `${count} ${decision}`;
}
